<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stocksignal.data.mapper.StockPoolMapper">

    <resultMap id="stockPoolMap" type="com.stocksignal.data.entity.StockPoolEntry">
        <result property="poolName" column="pool_name"/>
        <result property="market" column="market"/>
        <result property="code" column="code"/>
    </resultMap>

    <select id="findByPool" resultMap="stockPoolMap">
        SELECT * FROM stock_pool WHERE pool_name = #{poolName}
    </select>

    <insert id="insertIgnore" parameterType="com.stocksignal.data.entity.StockPoolEntry">
        INSERT IGNORE INTO stock_pool (pool_name, market, code)
        VALUES (#{poolName}, #{market}, #{code})
    </insert>

    <delete id="delete">
        DELETE FROM stock_pool
        WHERE pool_name = #{poolName} AND market = #{market} AND code = #{code}
    </delete>

</mapper>

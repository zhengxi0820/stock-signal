# 部署环境变量模板。复制为 env.sh 并填入真实值，chmod 600，严禁提交 git。
# 注意：本文件同时被 systemd EnvironmentFile 和 shell source 使用，
# 行首禁止写 export（systemd 会整行忽略，shell 侧用 set -a 自动导出）。

# 数据库
DB_URL='jdbc:mysql://localhost:3306/stock_signal?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai'
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stock_signal
DB_USER=stock
DB_PASSWORD='改为强密码'
# fetch 脚本（Linux 路径；Windows 本地开发用 .venv/Scripts/python.exe）
FETCH_PYTHON=/opt/stock-signal/fetch/.venv/bin/python
FETCH_DIR=/opt/stock-signal/fetch
# 通知：console（开发）/ wechat（PushPlus）
NOTIFIER=wechat
PUSHPLUS_TOKEN='你的PushPlus token'
# 页面访问口令（配置后启用登录；本机开发可留空关闭认证）
AUTH_TOKEN='页面访问口令'
# Cookie Secure：HTTPS 生产保持 true；HTTP 部署（无域名阶段）或本地调试设 false
SECURE_COOKIE=false
# swagger-ui：生产可关闭（认证启用后访问本就需登录）
SWAGGER_ENABLED=false
